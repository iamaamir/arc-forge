{
  "name": "arc-forge",
  "version": "0.1.0",
  "description": "Reusable agent skills and code-discipline tools.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/one-thing-functions/tests/*.test.mjs packages/forge-gate/tests/*.test.mjs skills/engineering/adaptive-ai-team-bootstrap/scripts/*.test.mjs",
    "check:skills": "npx skills add . --list",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "publish": "node scripts/release.mjs"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "coding-agent",
    "code-discipline"
  ],
  "license": "MIT"
}
