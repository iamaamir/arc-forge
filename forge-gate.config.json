{
  "roots": ["scripts", "packages", "skills"],
  "ignore": ["node_modules", ".git", "dist", "coverage", "reports", "fixtures"],
  "dependencyRules": {
    "rules": [
      { "from": "packages/one-thing-functions/**", "allow": [] },
      { "from": "packages/forge-gate/**",          "allow": [] },
      { "from": "scripts/**",                      "allow": [], "forbid": ["packages/*/src/**", "packages/*/bin/**"] },
      { "from": "docs/**",                         "allow": [] }
    ],
    "allowNodeModules": true,
    "unmatched": "allow"
  }
}
